{
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/patrice-de-moncan",
      "destination": "/#interlocuteurs",
      "permanent": false
    },
    {
      "source": "/debra-finerman",
      "destination": "/#interlocuteurs",
      "permanent": false
    },
    {
      "source": "/patrice-de-moncan.html",
      "destination": "/#interlocuteurs",
      "permanent": false
    },
    {
      "source": "/debra-finerman.html",
      "destination": "/#interlocuteurs",
      "permanent": false
    },
    {
      "source": "/maison",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/maison.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
